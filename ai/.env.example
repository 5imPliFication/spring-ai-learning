# Copy to ai/.env and fill in. Never commit the real file.

PORT=8080
JWT-SECRET=change-me-to-a-long-random-string-at-least-32-chars
AI-API-KEY=

# Postgres (Railway sets PG* automatically)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chat
PGUSER=postgres
PGPASSWORD=
# require on Railway; disable for a local Postgres without SSL
PGSSLMODE=disable

# Frontend origin: used for invite links, OAuth redirects back, and CORS
FRONTEND_BASE_URL=http://localhost:5173
# Optional: extra comma-separated CORS origins (defaults to FRONTEND_BASE_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.up.railway.app

# Optional rate limits (defaults shown)
# AI_RATE_PER_MINUTE=10
# AI_RATE_PER_DAY=100
# AUTH_RATE_PER_MINUTE=5
# AI_MAX_TOKENS=512
# AI_STREAMING_ENABLED=true

# Cloudflare R2 (media uploads)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Google OAuth (Calendar)
OAUTH-CLIENT-ID=
OAUTH-CLIENT-SECRET=
OAUTH-REDIRECT-URI=http://localhost:8080/api/v1/oauth/google/callback
